#compdef zhiva

_zhiva() {
  local -a subcommands
  local -A aliases
  local cur cmd

  subcommands=(
    'start:Start a Zhiva application'
    'install:Install an application'
    'create:Create a new application from the template'
    'uninstall:Uninstall an application'
    'list:List installed applications'
    'open:Open an application in the browser'
    'self:Update Zhiva itself'
    'update:Update installed applications'
    'guess:Find app by name (fuzzy)'
    'search:Search for apps'
    'cdf:Create desktop file for an installed application'
    'db:Interact with Zhiva database'
    'protocol:Zhiva protocol handler'
    'doctor:Check the Zhiva installation'
    'version:Show version information'
    'help:Show help message'
  )

  aliases=(
    [run]=start [startup]=start [o]=start [r]=start
    [i]=install [add]=install
    [new]=create
    [rm]=uninstall [remove]=uninstall
    [l]=list [ls]=list
    [link]=open
    [update-self]=self [self-update]=self
    [u]=update [up]=update
    [find]=guess
    [s]=search
    [create-desktop-file]=cdf
    [--version]=version [-v]=version [v]=version
  )

  cur=${words[CURRENT]}

  if (( CURRENT == 2 )); then
    _describe 'command' subcommands
    return
  fi

  cmd=$words[2]
  [[ -n ${aliases[$cmd]} ]] && cmd=${aliases[$cmd]}

  case $cmd in
    start)
      _arguments -C \
        '(-h --help)'{-h,--help}'[Show help]' \
        '(-e --engine)'{-e,--engine}'[Update engine mode]:mode:(0 1 2)' \
        '(-d --deps)'{-d,--deps}'[Update dependencies mode]:mode:(0 1 2)' \
        '(-u --update)'{-u,--update}'[Force engine and deps update]' \
        '*:app name:_zhiva_guess'
      ;;
    create)
      _arguments -C \
        '(-h --help)'{-h,--help}'[Show help]' \
        '(-t --template)'{-t,--template}'[Template repository]:url:_urls' \
        '(-a --author)'{-a,--author}'[Author name]:name: _normal' \
        '--display-name[Display name]:name: _normal' \
        '--description[Description]:text: _normal' \
        '--no-install[Skip dependency installation]' \
        '--no-input[Do not ask questions]' \
        '*:name: _normal'
      ;;
    install)
      _arguments -C \
        '(-h --help)'{-h,--help}'[Show help]' \
        '(-s --shortcut)'{-s,--shortcut}'[Control desktop shortcuts]:value:(m d n md dm)' \
        '(-n --name)'{-n,--name}'[Set the app name]:name: _normal' \
        '*:app name:_zhiva_guess'
      ;;
    uninstall)
      _arguments -C \
        '(-h --help)'{-h,--help}'[Show help]' \
        '*:app name:_zhiva_guess'
      ;;
    list)
      _arguments -C '(-h --help)'{-h,--help}'[Show help]'
      ;;
    open)
      _arguments -C \
        '(-h --help)'{-h,--help}'[Show help]' \
        '*:url:_urls'
      ;;
    self|update)
      _arguments -C '(-h --help)'{-h,--help}'[Show help]'
      ;;
    guess)
      _arguments -C '*:app name:_zhiva_guess'
      ;;
    search)
      _arguments -C \
        '(-h --help)'{-h,--help}'[Show help]' \
        '(-j --json)'{-j,--json}'[Output as JSON]' \
        '(-p --pretty)'{-p,--pretty}'[Output as pretty JSON]' \
        '*:query:_zhiva_guess'
      ;;
    cdf)
      _arguments -C \
        '(-h --help)'{-h,--help}'[Show help]' \
        '*:app name:_zhiva_guess'
      ;;
    db)
      _arguments -C \
        '(-h --help)'{-h,--help}'[Show help]' \
        '*:args: _normal'
      ;;
    doctor|protocol)
      _arguments -C '(-h --help)'{-h,--help}'[Show help]'
      ;;
    version)
      _arguments -C '--json[Output as JSON]'
      ;;
    help|*)
      _describe 'command' subcommands
      ;;
  esac
}

_zhiva_guess() {
  local cur suggestions
  cur=${words[CURRENT]}

  if [[ $cur == -* ]]; then
    compadd -- -h --help -e --engine -d --deps
    return
  fi

  if [[ -z $cur ]]; then
    suggestions=(${(f)"$(zhiva guess 2>/dev/null)"})
  else
    suggestions=(${(f)"$(zhiva guess "$cur" 2>/dev/null)"})
  fi

  if (( ${#suggestions[@]} )); then
    compadd -a suggestions
  fi
}

compdef _zhiva zhiva
